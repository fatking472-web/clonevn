# Cổng Dịch vụ công - Biến môi trường
# COPY file này thành .env và điền giá trị thực

# ⚠️ BẮT BUỘC: Thay bằng chuỗi ngẫu nhiên dài ít nhất 64 ký tự
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_STRING_HERE

# Cổng chạy server (Railway/Render tự gán PORT)
PORT=3000

# production | development
NODE_ENV=production

# CORS: Thay bằng domain thật của bạn
# CORS_ORIGIN=https://yourdomain.com

# Tùy chọn: Override CCCD admin mặc định
# ADMIN_CCCD=000000000000
